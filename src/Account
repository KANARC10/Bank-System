// this is a class that describes an Account
public class Account{
   private Customer accountHolder;
   private double accountBalance=0;
   private int accountNumber;

   // methods to manipulate the account
  public Account(Customer customer,int accountNumber,double accountBalance){
        this.accountNumber=accountNumber;
        this.accountHolder=customer;
          
           if(accountBalance<0){
        System.out.println("Invalid balance");
         this.accountBalance=0;
                  }
         else{
             this.accountBalance=accountBalance;
                         }  
                             }
  public double depositAmount(double amount){
          if(amount<=0){
          System.out.println("amount is not a valid deposit");
             return accountBalance;
                   }
         else{
          this.accountBalance= accountBalance+amount;
               return accountBalance;    
              }
                    }
  public double withdrawAmount(double amount){
             if(amount<=0)
                   {
             System.out.println("amount is invalid");
                    return accountBalance;         
                        }

           else if(accountBalance<amount){
             System.out.println("you have insufficient bank balance");
                return accountBalance; 
                               }
         
             else{
            this.accountBalance= accountBalance-amount;
                   return accountBalance;
                             }
                    }
  public int getAccountNumber(){
     return accountNumber;
              }
  public Customer getAccountHolder(){
      return accountHolder;
                }

  public double checkBalance(){
                 return accountBalance;
                          }
               }